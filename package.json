  "description": "直观卡片 (Lucid Cards) — Compact, explicitly labeled Home Assistant Lovelace cards for lights, fans, climate, and protected outlets.",
  "type": "module",
  "main": "dist/lucid-cards.js",
  "files": [
    "dist/lucid-cards.js",
    "hacs.json",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
